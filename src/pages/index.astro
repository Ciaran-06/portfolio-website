---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const projects = [
	{
		name: 'QuantSoc trading algorithm',
		description: 'Supervised research project building a live trading algorithm.',
		status: 'In progress',
	},
	{
		name: 'Black–Scholes and stochastic volatility study',
		description: 'Where the Black–Scholes–Merton assumptions fail in practice, and how to model volatility better.',
		status: 'Paused until summer',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Ciaran Gaffney</h1>
				<p class="tagline">Mathematics at the University of Edinburgh · Options and volatility</p>
				<p>
					I write research notes on volatility, market data and the maths behind them, each with
					code and an honest look at what didn't work.
				</p>
			</section>

			<section>
				<h2>Latest research notes</h2>
				{posts.length > 0 ? (
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<FormattedDate date={post.data.pubDate} />
							</li>
						))}
					</ul>
				) : (
					<p class="muted">First note coming soon: <em>Is volatility clustering real?</em></p>
				)}
			</section>

			<section>
				<h2>Projects</h2>
				<div class="projects">
					{projects.map((p) => (
						<div class="card">
							<h3>{p.name}</h3>
							<p>{p.description}</p>
							<span class="status">{p.status}</span>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section { margin-bottom: 3rem; }
	.intro h1 { margin-bottom: 0.25rem; }
	.tagline { color: rgb(var(--gray)); margin-top: 0; }
	.muted { color: rgb(var(--gray)); }
	.posts { list-style: none; padding: 0; }
	.posts li {
		display: flex; justify-content: space-between; gap: 1rem;
		padding: 0.5rem 0; border-bottom: 1px solid rgb(var(--gray-light));
	}
	.projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
	.card { border: 1px solid rgb(var(--gray-light)); border-radius: 8px; padding: 1rem; }
	.card h3 { font-size: 1.1rem; margin: 0 0 0.5rem; }
	.card p { margin: 0 0 0.75rem; font-size: 0.95rem; }
	.status { font-size: 0.85rem; color: var(--accent); }
	.links { display: flex; flex-wrap: wrap; gap: 1.5rem; }
</style>